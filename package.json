{
    "name": "fabrica",
    "version": "1.0.0",
    "description": "Fabrica - Manufacturing Services Website TailwindCSS 4 Template",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env server/index.js --dev",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node --env-file-if-exists=.env server/index.js",
        "admin": "node --env-file-if-exists=.env server/admin.js",
        "test:server": "node --test tests/server/*.test.js",
        "mail:local": "node server/local-mailbox.js",
        "mail:check": "node --env-file-if-exists=.env server/check-mail.js"
    },
    "author": "Mostafa Akajdid",
    "private": true,
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.1.18",
        "glob": "^11.0.2",
        "mailparser": "^3.14.1",
        "path": "^0.12.7",
        "postcss": "^8.5.3",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "smtp-server": "^3.21.3",
        "vite": "^7.3.1",
        "vite-plugin-handlebars": "^2.0.0"
    },
    "dependencies": {
        "@iconify/json": "^2.2.435",
        "@iconify/tailwind4": "^1.2.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "aos": "^2.3.4",
        "express": "^5.3.0",
        "gumshoejs": "^5.1.2",
        "isotope-layout": "^3.0.6",
        "jarallax": "^2.1.4",
        "lightgallery": "^2.9.0",
        "nodemailer": "^10.3.1",
        "pdfjs-dist": "^6.4.299",
        "preline": "^4.0.1",
        "smoothscroll-for-websites": "^1.5.1",
        "swiper": "^11.2.6",
        "tailwindcss": "^4.1.18",
        "tailwindcss-motion": "^1.1.1"
    },
    "engines": {
        "node": ">=24.0.0"
    }
