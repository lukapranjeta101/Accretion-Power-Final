# Server only. Never prefix secrets with VITE_. Copy to .env, which is gitignored.
APP_BASE_URL=http://localhost:5173
PORT=5173
HOST=127.0.0.1
DATABASE_PATH=var/accretion.sqlite
ACCOUNT_APPROVAL_EMAIL=lukapranjeta18@gmail.com
# Local Mailpit receives real SMTP messages without delivering to outside inboxes.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Accretion Power <accounts@accretion.test>
# For live delivery, set your provider's SMTP settings and a verified MAIL_FROM.
# Production additionally requires NODE_ENV=production and an HTTPS APP_BASE_URL.

# Gmail delivery (replace the SMTP values above; keep credentials only in .env):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# MAIL_FROM=Accretion Power <your-sending-account@gmail.com>
# Use an App Password, not your normal Google password.
